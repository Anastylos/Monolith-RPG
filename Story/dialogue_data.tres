dialogs = {
"FIRST_DIALOG_1": {
"default": "[color=408070ff]What have you done? You awakend what was suposed to sleep. The monolith has tasted your soul. Now it will not stop untill it has consumed you.
Do you remember who you are and why you are here?[/color]",
"en": ""
},
"FIRST_DIALOG_2": {
"default": "[color=408070ff]Maybe it is better this way. Whatever you came here for, you will only find your doom.[/color]",
"en": ""
},
"FIRST_DIALOG_3": {
"default": "[color=408070ff]Only a fool would seek the Monolith to save their people. Your endevor is doomed, as was mine when I came here.[/color] ",
"en": ""
},
"FIRST_DIALOG_4": {
"default": "[color=408070ff]Look at these damned that once where my people.[/color]",
"en": ""
},
"FIRST_OPT1_1": {
"default": "Who am I? Where am I?"
},
"FIRST_OPT1_2": {
"default": "I remember ... fragments. I need to save my people."
}
}
